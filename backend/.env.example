# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fecho
DB_USER=root
DB_PASS=

# Autenticacao
JWT_SECRET=troque-esta-chave-antes-de-entregar
JWT_EXPIRA=8h

# Servidor
PORT=3333
URL_FRONT=http://localhost:5173

# E-mail de teste (Mailtrap). Se ficar em branco, o link de recuperacao
# aparece no console do servidor em vez de ser enviado por e-mail.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Retencao de conta inativa (opcional; estes sao os padroes).
# Meses sem voltar ate os dados pessoais serem apagados, e dias de aviso por e-mail antes.
# RETENCAO_MESES=12
# RETENCAO_AVISO_DIAS=30

# US12 - dias de guarda das imagens do chat e das fotos do pedido depois que o
# servico encerra (opcional; este e o padrao).
# MIDIAS_RETENCAO_DIAS=90
