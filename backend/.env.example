# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fecho
DB_USER=root
DB_PASS=

# Autenticacao
JWT_SECRET=troque-esta-chave-antes-de-entregar
JWT_EXPIRA=8h

# Chave usada na impressao digital do CPF (US04).
# Se mudar depois que o sistema estiver em uso, o sistema deixa de
# reconhecer quem apagou a conta e voltou. Defina uma vez e nao troque.
CPF_PEPPER=troque-esta-chave-e-nunca-mais-mude

# Servidor
PORT=3333
URL_FRONT=http://localhost:5173

# E-mail de teste (Mailtrap). Se ficar em branco, o link de recuperacao
# aparece no console do servidor em vez de ser enviado por e-mail.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
